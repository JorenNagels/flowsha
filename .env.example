# Contact Lambda (SES). Copy to .env.local for local dev (gitignored).
TO_EMAIL=hello@flowsha.co.uk
FROM_EMAIL=hello@flowsha.co.uk
AWS_SES_REGION=eu-west-2

# Dashboard auth (Clerk). The Lambda verifies dashboard session JWTs against this
# issuer's public JWKS. Get it from the Clerk dashboard (Frontend API / issuer),
# e.g. https://<slug>.clerk.accounts.dev (dev) or https://clerk.flowsha.co.uk (prod).
# CLERK_ISSUER=
# Optional comma-separated email allowlist (defence-in-depth; needs an email claim
# in the Clerk session token). Empty = rely on Clerk invite-only.
# DASHBOARD_ALLOWED_EMAILS=

# DynamoDB table names are injected by CDK at deploy (FEEDBACK_TABLE_NAME,
# WAIVER_TABLE_NAME, PRODUCTS_TABLE_NAME, ORDERS_TABLE_NAME) — no need to set them
# for local dev; the Lambda logs and skips the write when they're unset.

# --- Shop (Stripe) ---
# In production these come from SSM SecureStrings, wired by CDK as
# STRIPE_SECRET_PARAM / STRIPE_WEBHOOK_SECRET_PARAM. For local dev, paste the
# TEST-mode values here instead. Unset = /checkout returns a clear 503.
# STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3001/stripe-webhook`.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Used to build Stripe's success/cancel redirect URLs (CDK sets this in prod).
# SITE_URL=http://localhost:3000
# S3 bucket for dashboard photo uploads (CDK sets both in prod).
# MEDIA_BUCKET_NAME=
# MEDIA_BASE_URL=

# Local dev only: run the Lambda dev server on a different port.
# PORT=3001

# Frontend: the deployed Lambda Function URL (or http://localhost:3001 for local dev).
# Set this in web/.env.local for the web workspace.
# NEXT_PUBLIC_CONTACT_API_URL=http://localhost:3001
# Clerk publishable key for the dashboard/login (public). Set in web/.env.local.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Turnstile site key (public). Set in web/.env.local.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Separate Turnstile key for checkout, configured as **Managed** in the Cloudflare
# dashboard so it renders a visible checkbox. Whether the widget is visible is a
# property of the key, not a render option, so checkout needs its own. Falls back
# to the invisible key above when unset.
# NEXT_PUBLIC_TURNSTILE_CHECKOUT_SITE_KEY=
