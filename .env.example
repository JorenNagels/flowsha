# Contact Lambda (SES). Copy to .env.local for local dev (gitignored).
TO_EMAIL=hello@flowsha.co.uk
FROM_EMAIL=hello@flowsha.co.uk
AWS_SES_REGION=eu-west-2

# Dashboard auth (Clerk). The Lambda verifies dashboard session JWTs against this
# issuer's public JWKS. Get it from the Clerk dashboard (Frontend API / issuer),
# e.g. https://<slug>.clerk.accounts.dev (dev) or https://clerk.flowsha.co.uk (prod).
# CLERK_ISSUER=
# Optional comma-separated email allowlist (defence-in-depth; needs an email claim
# in the Clerk session token). Empty = rely on Clerk invite-only.
# DASHBOARD_ALLOWED_EMAILS=

# DynamoDB table names are injected by CDK at deploy (FEEDBACK_TABLE_NAME,
# WAIVER_TABLE_NAME) — no need to set them for local dev; the Lambda logs and
# skips the write when they're unset.

# Frontend: the deployed Lambda Function URL (or http://localhost:3001 for local dev).
# Set this in web/.env.local for the web workspace.
# NEXT_PUBLIC_CONTACT_API_URL=http://localhost:3001
# Clerk publishable key for the dashboard/login (public). Set in web/.env.local.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
